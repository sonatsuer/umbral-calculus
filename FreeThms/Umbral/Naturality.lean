/-
# Why the free theorem is naturality here

`Umbral/OneLanguage.lean` obtains Rota's substitution principle as the free
theorem of `∀K U A. Umbral K U A ⇒ U → K`: the denotation of every closed term
preserves every triple of relations that respects the thirteen members of the
class. This file shows that, at this type, preserving every respecting relation
is the same as commuting with every **homomorphism of dictionaries**.

* `DictHom`: maps of scalars, umbrae and umbral polynomials commuting with the
  thirteen members.
* `parametric_iff_natural`: a family of functionals preserves every respecting
  relation triple if and only if it commutes with every `DictHom`. One direction
  is that the graphs of a homomorphism respect the class. The other is a
  tabulation: the pairs related by a respecting triple carry a dictionary of
  their own, and its two projections are homomorphisms.
* `den_natural`: so the denotation of every closed term commutes with every
  homomorphism.

The results of `Language.lean` then read as naturality:

* `similarity_natural`: the substitution principle is naturality along the
  homomorphism induced by a moment-preserving renaming (`DictHom.ofMomentMap`);
* `integrality_natural`: integrality is naturality along the inclusion of the
  moment dictionary over the subring generated by the moments (`DictHom.ofSubring`).

The equivalence holds because every member of the class takes arguments of base
type, so the related pairs are closed under the members and form a dictionary.
The same argument works whenever the type variables occur in the arguments only
to the left of a single arrow. That includes the Church numerals
`∀X. (X → X) → X → X` of `Core/SystemF.lean`, whose induction principle
(`poly_church`) is naturality along the inclusion of the substructure generated
by the starting point. It can fail when a type variable occurs to the left of
two arrows inside an argument, as in `((X → X) → X) → X`.
-/

import FreeThms.Umbral.Language

namespace FreeThms.Umbral.Restricted

open FreeThms

/-! ## Homomorphisms of dictionaries -/

/-- A homomorphism of dictionaries: maps of scalars, umbrae and umbral
polynomials commuting with the thirteen members of the class. -/
structure DictHom {K₁ U₁ A₁ K₂ U₂ A₂ : Type}
    (d₁ : Dict K₁ U₁ A₁) (d₂ : Dict K₂ U₂ A₂) where
  /-- The map of scalars. -/
  hK : K₁ → K₂
  /-- The map of umbrae. -/
  hU : U₁ → U₂
  /-- The map of umbral polynomials. -/
  hA : A₁ → A₂
  zeroK : hK d₁.zeroK = d₂.zeroK
  oneK : hK d₁.oneK = d₂.oneK
  addK : ∀ x z, hK (d₁.addK x z) = d₂.addK (hK x) (hK z)
  mulK : ∀ x z, hK (d₁.mulK x z) = d₂.mulK (hK x) (hK z)
  negK : ∀ x, hK (d₁.negK x) = d₂.negK (hK x)
  zeroA : hA d₁.zeroA = d₂.zeroA
  oneA : hA d₁.oneA = d₂.oneA
  addA : ∀ p q, hA (d₁.addA p q) = d₂.addA (hA p) (hA q)
  mulA : ∀ p q, hA (d₁.mulA p q) = d₂.mulA (hA p) (hA q)
  negA : ∀ p, hA (d₁.negA p) = d₂.negA (hA p)
  constA : ∀ x, hA (d₁.constA x) = d₂.constA (hK x)
  injA : ∀ u, hA (d₁.injA u) = d₂.injA (hU u)
  evalA : ∀ p, hK (d₁.evalA p) = d₂.evalA (hA p)

variable {K₁ U₁ A₁ K₂ U₂ A₂ : Type} {d₁ : Dict K₁ U₁ A₁} {d₂ : Dict K₂ U₂ A₂}

/-- **The graphs of a homomorphism respect the class.** -/
theorem DictHom.respects (h : DictHom d₁ d₂) :
    Respects d₁ d₂ (fun x y => h.hK x = y) (fun u v => h.hU u = v)
      (fun p q => h.hA p = q) where
  zeroK := h.zeroK
  oneK := h.oneK
  addK := by rintro x _ rfl z _ rfl; exact h.addK x z
  mulK := by rintro x _ rfl z _ rfl; exact h.mulK x z
  negK := by rintro x _ rfl; exact h.negK x
  zeroA := h.zeroA
  oneA := h.oneA
  addA := by rintro p _ rfl q _ rfl; exact h.addA p q
  mulA := by rintro p _ rfl q _ rfl; exact h.mulA p q
  negA := by rintro p _ rfl; exact h.negA p
  constA := by rintro x _ rfl; exact h.constA x
  injA := by rintro u _ rfl; exact h.injA u
  evalA := by rintro p _ rfl; exact h.evalA p

/-! ## The tabulation of a respecting triple -/

section Tabulation

variable {R : K₁ → K₂ → Prop} {S : U₁ → U₂ → Prop} {T : A₁ → A₂ → Prop}

/-- **The related pairs carry a dictionary.** Each member acts componentwise, and
the corresponding clause of `Respects` says the result is again a related pair. -/
def pairDict (h : Respects d₁ d₂ R S T) :
    Dict {x : K₁ × K₂ // R x.1 x.2} {u : U₁ × U₂ // S u.1 u.2}
      {p : A₁ × A₂ // T p.1 p.2} where
  zeroK := ⟨(d₁.zeroK, d₂.zeroK), h.zeroK⟩
  oneK := ⟨(d₁.oneK, d₂.oneK), h.oneK⟩
  addK x z := ⟨(d₁.addK x.1.1 z.1.1, d₂.addK x.1.2 z.1.2), h.addK _ _ x.2 _ _ z.2⟩
  mulK x z := ⟨(d₁.mulK x.1.1 z.1.1, d₂.mulK x.1.2 z.1.2), h.mulK _ _ x.2 _ _ z.2⟩
  negK x := ⟨(d₁.negK x.1.1, d₂.negK x.1.2), h.negK _ _ x.2⟩
  zeroA := ⟨(d₁.zeroA, d₂.zeroA), h.zeroA⟩
  oneA := ⟨(d₁.oneA, d₂.oneA), h.oneA⟩
  addA p q := ⟨(d₁.addA p.1.1 q.1.1, d₂.addA p.1.2 q.1.2), h.addA _ _ p.2 _ _ q.2⟩
  mulA p q := ⟨(d₁.mulA p.1.1 q.1.1, d₂.mulA p.1.2 q.1.2), h.mulA _ _ p.2 _ _ q.2⟩
  negA p := ⟨(d₁.negA p.1.1, d₂.negA p.1.2), h.negA _ _ p.2⟩
  constA x := ⟨(d₁.constA x.1.1, d₂.constA x.1.2), h.constA _ _ x.2⟩
  injA u := ⟨(d₁.injA u.1.1, d₂.injA u.1.2), h.injA _ _ u.2⟩
  evalA p := ⟨(d₁.evalA p.1.1, d₂.evalA p.1.2), h.evalA _ _ p.2⟩

/-- The first projection is a homomorphism. -/
def pairFst (h : Respects d₁ d₂ R S T) : DictHom (pairDict h) d₁ where
  hK x := x.1.1
  hU u := u.1.1
  hA p := p.1.1
  zeroK := rfl
  oneK := rfl
  addK _ _ := rfl
  mulK _ _ := rfl
  negK _ := rfl
  zeroA := rfl
  oneA := rfl
  addA _ _ := rfl
  mulA _ _ := rfl
  negA _ := rfl
  constA _ := rfl
  injA _ := rfl
  evalA _ := rfl

/-- The second projection is a homomorphism. -/
def pairSnd (h : Respects d₁ d₂ R S T) : DictHom (pairDict h) d₂ where
  hK x := x.1.2
  hU u := u.1.2
  hA p := p.1.2
  zeroK := rfl
  oneK := rfl
  addK _ _ := rfl
  mulK _ _ := rfl
  negK _ := rfl
  zeroA := rfl
  oneA := rfl
  addA _ _ := rfl
  mulA _ _ := rfl
  negA _ := rfl
  constA _ := rfl
  injA _ := rfl
  evalA _ := rfl

end Tabulation

/-! ## Parametric is natural, for functionals of an umbra -/

/-- A family of scalar functionals of one umbra, one for every dictionary. The
denotation of a closed term of `∀K U A. Umbral K U A ⇒ U → K` is one. The write-up
calls it a class function on dictionaries, since the dictionaries form a proper
class; here the carriers range over the universe `Type`, so it is a function. -/
abbrev Family := ∀ (K U A : Type), Dict K U A → U → K

/-- The family preserves every relation triple that respects the class. -/
def Parametric (F : Family) : Prop :=
  ∀ {K₁ U₁ A₁ K₂ U₂ A₂ : Type} (d₁ : Dict K₁ U₁ A₁) (d₂ : Dict K₂ U₂ A₂)
    (R : K₁ → K₂ → Prop) (S : U₁ → U₂ → Prop) (T : A₁ → A₂ → Prop),
    Respects d₁ d₂ R S T →
      ∀ u₁ u₂, S u₁ u₂ → R (F K₁ U₁ A₁ d₁ u₁) (F K₂ U₂ A₂ d₂ u₂)

/-- The family commutes with every homomorphism of dictionaries. -/
def Natural (F : Family) : Prop :=
  ∀ {K₁ U₁ A₁ K₂ U₂ A₂ : Type} (d₁ : Dict K₁ U₁ A₁) (d₂ : Dict K₂ U₂ A₂)
    (h : DictHom d₁ d₂) (u : U₁), h.hK (F K₁ U₁ A₁ d₁ u) = F K₂ U₂ A₂ d₂ (h.hU u)

/-- **At this type, parametric is natural.** -/
theorem parametric_iff_natural (F : Family) : Parametric F ↔ Natural F := by
  constructor
  · intro hp K₁ U₁ A₁ K₂ U₂ A₂ d₁ d₂ h u
    exact hp d₁ d₂ _ _ _ h.respects u (h.hU u) rfl
  · intro hn K₁ U₁ A₁ K₂ U₂ A₂ d₁ d₂ R S T h u₁ u₂ hu
    let w : {u : U₁ × U₂ // S u.1 u.2} := ⟨(u₁, u₂), hu⟩
    have h₁ := hn (pairDict h) d₁ (pairFst h) w
    have h₂ := hn (pairDict h) d₂ (pairSnd h) w
    have hw := (F _ _ _ (pairDict h) w).2
    simp only [pairFst, pairSnd] at h₁ h₂
    rw [← h₁, ← h₂]
    exact hw

/-- The denotation of a closed term, as a family. -/
def denFamily (t : PClosedTm oneUmbraTy) : Family :=
  fun K U A d => den K U A d t

/-- The denotation of every closed term is parametric: this is `den_rel`. -/
theorem den_parametric (t : PClosedTm oneUmbraTy) : Parametric (denFamily t) :=
  fun d₁ d₂ R S T h u₁ u₂ hu => den_rel d₁ d₂ R S T h t u₁ u₂ hu

/-- **The denotation of every closed term commutes with every homomorphism of
dictionaries.** -/
theorem den_natural (t : PClosedTm oneUmbraTy) : Natural (denFamily t) :=
  (parametric_iff_natural _).1 (den_parametric t)

/-! ## The results, as naturality -/

variable {k : Type} [CommRing k] {Name : Type}

/-- **A moment-preserving renaming induces a homomorphism of dictionaries.** The
`evalA` equation is `eval_rename`, which is where injectivity is used. -/
noncomputable def DictHom.ofMomentMap {ρ₁ ρ₂ : Assign Name k} (σ : MomentMap ρ₁ ρ₂) :
    DictHom (momDict ρ₁) (momDict ρ₂) where
  hK x := x
  hU := σ.toFun
  hA := MvPolynomial.rename σ.toFun
  zeroK := rfl
  oneK := rfl
  addK _ _ := rfl
  mulK _ _ := rfl
  negK _ := rfl
  zeroA := map_zero _
  oneA := map_one _
  addA p q := map_add _ p q
  mulA p q := map_mul _ p q
  negA p := map_neg _ p
  constA x := MvPolynomial.rename_C _ x
  injA u := MvPolynomial.rename_X _ u
  evalA p := (eval_rename σ p).symm

/-- **The substitution principle, as naturality.** Similar umbrae give equal
values, because the transposition exchanging them induces a homomorphism. -/
theorem similarity_natural [DecidableEq Name] (ρ : Assign Name k) {a b : Name}
    (hab : Similar ρ ρ a b) (t : PClosedTm oneUmbraTy) :
    den k Name (MvPolynomial Name k) (momDict ρ) t a
      = den k Name (MvPolynomial Name k) (momDict ρ) t b := by
  have h := den_natural t (momDict ρ) (momDict ρ) (DictHom.ofMomentMap (swapMap ρ hab)) a
  simpa [denFamily, DictHom.ofMomentMap, swapMap, Equiv.swap_apply_left] using h

/-- Evaluation commutes with a change of coefficient ring that carries the
moments. -/
theorem eval_map_of_comp {k' : Type} [CommRing k'] (ρ' : Assign Name k') (ρ : Assign Name k)
    (φ : k' →+* k) (hρ : ∀ a i, ρ a i = φ (ρ' a i)) (p : MvPolynomial Name k') :
    eval ρ (MvPolynomial.map φ p) = φ (eval ρ' p) := by
  classical
  have hw : ∀ d : Name →₀ ℕ, φ (weight ρ' d) = weight ρ d := by
    intro d
    rw [weight, weight, Finsupp.prod, Finsupp.prod, map_prod]
    exact Finset.prod_congr rfl fun a _ => (hρ a (d a)).symm
  induction p using MvPolynomial.induction_on' with
  | monomial d c =>
      rw [MvPolynomial.map_monomial, eval_monomial, eval_monomial, map_mul, hw d]
  | add p q hp hq => rw [map_add, eval_add, eval_add, hp, hq, map_add]

/-- The moments of `ρ`, as an assignment into the subring `k_ρ` they generate. -/
def subringAssign (ρ : Assign Name k) : Assign Name (momentSubring ρ) :=
  fun a i => ⟨ρ a i, moment_mem ρ a i⟩

/-- **The inclusion of the moment dictionary over `k_ρ` into the one over `k`.** -/
noncomputable def DictHom.ofSubring (ρ : Assign Name k) :
    DictHom (momDict (subringAssign ρ)) (momDict ρ) where
  hK := Subtype.val
  hU := id
  hA := MvPolynomial.map (momentSubring ρ).subtype
  zeroK := by simp [momDict]
  oneK := by simp [momDict]
  addK _ _ := by simp [momDict]
  mulK _ _ := by simp [momDict]
  negK _ := by simp [momDict]
  zeroA := by simp [momDict]
  oneA := by simp [momDict]
  addA _ _ := by simp [momDict]
  mulA _ _ := by simp [momDict]
  negA _ := by simp [momDict]
  constA _ := by simp [momDict]
  injA _ := by simp [momDict]
  evalA p := (eval_map_of_comp (subringAssign ρ) ρ (momentSubring ρ).subtype
    (fun _ _ => rfl) p).symm

/-- **Integrality, as naturality** along the inclusion of the moment dictionary
over `k_ρ` into the one over `k`: the value over `k` is the value over `k_ρ`. -/
theorem integrality_natural (ρ : Assign Name k) (t : PClosedTm oneUmbraTy) (a : Name) :
    den k Name (MvPolynomial Name k) (momDict ρ) t a ∈ momentSubring ρ := by
  have := den_natural t _ _ (DictHom.ofSubring ρ) a
  simp only [denFamily, DictHom.ofSubring, id] at this
  rw [← this]
  exact Subtype.property _

end FreeThms.Umbral.Restricted
